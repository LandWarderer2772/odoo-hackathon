{
  "name": "brightloop-subscription-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "turbo dev",
    "start:db": "tsx scripts/start-db.ts",
    "dev:db": "tsx scripts/start-db.ts",
    "dev:web": "npm run dev -w @brightloop/web",
    "dev:api": "npm run dev -w @brightloop/api",
    "dev:worker": "npm run dev -w @brightloop/worker",
    "start:web": "npm run start -w @brightloop/web",
    "start:api": "npm run start -w @brightloop/api",
    "start:worker": "npm run start -w @brightloop/worker",
    "build": "turbo build",
    "build:web": "npm run build -w @brightloop/web",
    "build:api": "npm run build -w @brightloop/api",
    "build:worker": "npm run build -w @brightloop/worker",
    "lint": "turbo lint",
    "db:generate": "npm run db:generate -w @brightloop/db",
    "db:migrate": "npm run db:migrate -w @brightloop/db",
    "db:push": "npm run db:push -w @brightloop/db",
    "db:seed": "npm run db:seed -w @brightloop/db"
  },
  "packageManager": "npm@12.2.1",
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.11.10"
  }
}
